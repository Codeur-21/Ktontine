<?php

namespace App\Livewire\Auth;

use Livewire\Component;
use App\Models\Tenant;
use App\Models\User;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Str;
use Illuminate\Validation\Rules\Password;

class Register extends Component
{
  public string $name = '';
  public string $business_name = '';
  public string $phone = '';
  public string $email = '';
  public string $password = '';
  public string $password_confirmation = '';
  public bool $terms = false;

  public function register(): void
  {
    $data = $this->validate(
      [
        'name' => 'required|string|max:25',
        'business_name' => 'required|string|max:25',
        'phone' => 'required|digits:9',
        'email' => 'required|email|unique:users,email',
        'password' => [
          'required',
          'string',
          'confirmed',
          Password::min(8)->mixedCase()->numbers()->symbols(),
        ],
        'password_confirmation' => 'required|string|min:8',
        'terms' => 'accepted',
      ],
      [
        // Nom complet
        'name.required' => 'Veuillez renseigner votre nom complet.',
        'name.string' => 'Le nom doit être un texte valide.',
        'name.max' => 'Votre nom ne doit pas dépasser 25 caractères.',

        // Nom de l'espace Tontine
        'business_name.required' => 'Veuillez donner un nom à votre espace de tontine.',
        'business_name.string' => 'Le nom de votre espace doit être un texte valide.',
        'business_name.max' => 'Le nom de votre espace ne doit pas dépasser 25 caractères.',

        // Numéro de téléphone
        'phone.required' => 'Veuillez renseigner votre numéro de téléphone.',
        'phone.digits' => 'Votre numéro de téléphone doit contenir exactement 9 chiffres.',

        // Adresse email
        'email.required' => 'Veuillez renseigner votre adresse e-mail.',
        'email.email' => 'Veuillez saisir une adresse e-mail valide.',
        'email.unique' => 'Cette adresse e-mail est déjà associée à un compte.',

        // Mot de passe
        'password.required' => 'Veuillez créer un mot de passe.',
        'password.string' => 'Le mot de passe doit être un texte valide.',
        'password.min' => 'Votre mot de passe doit contenir au moins 8 caractères.',
        'password.mixed' =>
          'Votre mot de passe doit contenir au moins une majuscule et une minuscule.',
        'password.letters' => 'Votre mot de passe doit contenir au moins une lettre.',
        'password.numbers' => 'Votre mot de passe doit contenir au moins un chiffre.',
        'password.symbols' =>
          'Votre mot de passe doit contenir au moins un caractère spécial (ex. : @, #, !, $).',
        'password.confirmed' => 'Les mots de passe ne correspondent pas. Veuillez réessayer.',

        // Confirmation du mot de passe
        'password_confirmation.required' => 'Veuillez confirmer votre mot de passe.',

        // Conditions d'utilisation
        'terms.accepted' =>
          'Vous devez accepter les conditions d’utilisation pour créer votre compte.',
      ],
    );

    DB::transaction(function () use ($data): void {
      $tontine = Tenant::create([
        'name' => $data['business_name'],
        'slug' => Str::slug($data['business_name']) . '-' . time() . '-' . Str::lower(Str::random(6)),
      ]);

      User::create([
        'name' => $data['name'],
        'email' => $data['email'],
        'phone' => $data['phone'],
        'tenant_id' => $tontine->id,
        'password' => Hash::make($data['password']),
        'terms_accepted_at' => now(),
      ]);
    });

    session()->flash(
      'success',
      'Votre espace a ?t? cr?? avec succ?s. Vous pouvez maintenant vous connecter.',
    );

    $this->redirectRoute('login', navigate: true);
  }

  public function render(): View
  {
    return view('livewire.auth.register')->layout('components.layouts.auth-layout');
  }
}

                             
                           